# Starts paper_tracker.service at boot and every weekday at 11:00 New York if it is not already running — beside
# eod_recorder.timer. Copy beside the service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now paper_tracker.timer
[Unit]
Description=Start the Compass Phase 2 paper tracker

[Timer]
OnBootSec=2min
OnCalendar=Mon..Fri 11:00 America/New_York
Persistent=true
Unit=paper_tracker.service

[Install]
WantedBy=timers.target
