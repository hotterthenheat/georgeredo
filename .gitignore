# never commit secrets or raw bundle copies
*.env
.env*
secrets/
evidence/nuxt_bundle/
evidence/validation/bars/
evidence/validation/uw_bars/
evidence/validation/uw_tape_bars/
node_modules/
__pycache__/

# deep-research intermediate caches (raw option bars, grid arrays)
research/**/*.pkl
research/**/*.npz

# the Compass Phase 2 recorder's Parquet store (scripts/eod_recorder.py) — local data, never committed
data_recorder/

# --fetch-theta staging (scripts/paper_backtest.py): a fetch's files before they are validated and placed — never committed;
# the layout, its _manifest and any <file>.prev-<run> kept beside are
data/theta_*/_staging/
